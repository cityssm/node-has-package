{
  "name": "@cityssm/has-package",
  "version": "1.0.0",
  "description": "Tests if a package is available to be imported. Useful for checking if optional dependencies are installed.",
  "keywords": [
    "dependency",
    "dependencies",
    "optional",
    "import",
    "require"
  ],
  "homepage": "https://github.com/cityssm/node-has-package#readme",
  "bugs": {
    "url": "https://github.com/cityssm/node-has-package/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/node-has-package.git"
  },
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.*",
    "utilities.*"
  ],
  "scripts": {
    "coverage": "c8 --reporter=lcov --reporter=text --reporter=text-summary node --test \"test/test.js\"",
    "test": "node --test \"test/test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint-config-cityssm": "^59.0.1",
    "prettier-config-cityssm": "^2.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
